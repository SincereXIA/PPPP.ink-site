{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "static",
    ".build"
  ]
}
